CODEX_RUNNER_TOKEN=replace-with-a-long-random-bearer-token
CODEX_RUNNER_CODEX_BIN=/home/ubuntu/.local/bin/codex
CODEX_RUNNER_AUTH_JSON=/home/ubuntu/.codex/auth.json
CODEX_RUNNER_DEFAULT_WORKSPACE=/home/ubuntu
CODEX_RUNNER_ALLOWED_WORKSPACES=/home/ubuntu
CODEX_RUNNER_DATA_DIR=/home/ubuntu/codex-api-runner/data
CODEX_RUNNER_MAX_PROMPT_CHARS=200000
CODEX_RUNNER_MAX_CONCURRENT=1
CODEX_RUNNER_REQUEST_TIMEOUT_SECONDS=3600
ALLOW_DANGER_FULL_ACCESS=false
